DATABASE_URL=postgresql+psycopg://ai_fighters:ai_fighters@localhost:5432/ai_fighters
GEMINI_API_KEY=

# docker-compose.prod.yml 전용 — EC2에 두는 .env에서만 필요.
# db 서비스(번들 Postgres) 초기화 값이면서, 위 DATABASE_URL의 host를 localhost 대신 db로 바꿔서 쓴다.
# 예: DATABASE_URL=postgresql+psycopg://ai_fighters:<비밀번호>@db:5432/ai_fighters
POSTGRES_USER=ai_fighters
POSTGRES_PASSWORD=
POSTGRES_DB=ai_fighters
